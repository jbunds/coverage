{
  "$schema": "https://biomejs.dev",
  "assist": {
    "actions": {
      "source": {
        "organizeImports":     "off",
        "useSortedKeys":       "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.css",
      "**/*.js",
      "**/*.ts"
    ]
  },
  "formatter": { "enabled"  : false },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
