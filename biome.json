{
  "$schema"   : "https://biomejs.dev",
  "assist" : {
    "actions" : {
      "source" : {
        "organizeImports":     "off",
        "useSortedKeys":       "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files"     : {
    "includes" : [
      "**/*.css",
      "**/*.js"
    ]
  },
  "formatter" : { "enabled"  : false },
  "linter"    : { "enabled"  : true  }
}
