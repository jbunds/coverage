{
  "$schema"   : "https://biomejs.dev",
  "formatter" : { "enabled"  : false },
  "linter"    : { "enabled"  : true  },
  "files"     : {
    "includes" : [
      "**/*.css",
      "**/*.js",
      "!css/style.css"
    ]
  },
  "assist" : {
    "actions" : {
      "source" : {
        "organizeImports": "off"
      }
    }
  }
}
